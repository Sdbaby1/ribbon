# Copy to .env and fill the blanks. Never commit .env.
# Never put a private key in a VITE_ variable. Vite embeds those in the browser bundle.

# --- Web (baked in at build time) ---
# Public Arc RPC. The default works if you leave this blank in the app, but set it explicitly for production.
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# Address printed by `npm run deploy:arc`. Leave blank until that deploy succeeds.
VITE_RIBBON_ADDRESS=
# Empty means the browser calls /api on the same origin. Set this only if the API is on another host.
VITE_API_URL=

# --- Deploy (Hardhat). The private key spends USDC for gas on Arc. ---
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Canonical Arc USDC ERC-20 interface, 6 decimals. Do not change this unless Circle publishes a new address.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Hex private key of the deployer wallet. Fund it with USDC on Arc mainnet (chain 5042) before deploy:arc.
DEPLOYER_PRIVATE_KEY=

# --- API ---
# Same value as VITE_RIBBON_ADDRESS. The deploy script prints this line so the two stay in sync.
# Application code reads VITE_RIBBON_ADDRESS, not this name.
RIBBON_ADDRESS=
PORT=8787
# Comma-separated browser origins allowed to call the API. Add your public site origin before you submit.
WEB_ORIGIN=http://localhost:5173
# Optional override. Defaults to web/dist next to the built server.
WEB_DIST=

# --- Display names (optional locally, required for names to survive a restart) ---
# Create a Supabase project, run supabase/schema.sql, then paste the project URL and the service-role key.
# The browser never receives the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
